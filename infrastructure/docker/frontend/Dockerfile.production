FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/cloudsentinel-ui/package.json frontend/cloudsentinel-ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/cloudsentinel-ui/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine
USER root
RUN apk upgrade --no-cache
USER 101
COPY infrastructure/docker/nginx.production.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
