# Copy to .env, then replace both values with output from: openssl rand -hex 32
CLOUDSENTINEL_POSTGRES_PASSWORD=
CLOUDSENTINEL_JWT_SIGNING_KEY=
# Generate with Python's Fernet.generate_key() and store separately from database/JWT keys.
CLOUDSENTINEL_MFA_ENCRYPTION_KEY=

# Local Compose password recovery uses the Mailpit inbox at http://localhost:8025.
# Compose defaults SMTP to this isolated development inbox; no credentials needed.
# For non-development environments, configure an authenticated SMTP provider and
# keep CLOUDSENTINEL_SMTP_STARTTLS=true.
CLOUDSENTINEL_SMTP_HOST=mailpit
CLOUDSENTINEL_SMTP_PORT=1025
CLOUDSENTINEL_SMTP_USERNAME=
CLOUDSENTINEL_SMTP_PASSWORD=
CLOUDSENTINEL_SMTP_FROM_EMAIL=cloudsentinel@localhost.test
CLOUDSENTINEL_SMTP_STARTTLS=false
CLOUDSENTINEL_FRONTEND_BASE_URL=http://localhost:5173
CLOUDSENTINEL_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# AWS validation defaults to real STS. In local mock mode, connection checks
# and scan jobs use the mock provider; scans create no cloud assets or AWS calls.
CLOUDSENTINEL_AWS_VALIDATION_MODE=real
CLOUDSENTINEL_AWS_MOCK_SCENARIO=success

# Optional private S3/MinIO-compatible report artifact storage.
# Leave the bucket empty to export completed report snapshots from the API.
CLOUDSENTINEL_REPORT_STORAGE_BUCKET=
CLOUDSENTINEL_REPORT_STORAGE_PREFIX=cloudsentinel/development/reports
CLOUDSENTINEL_REPORT_STORAGE_REGION=
CLOUDSENTINEL_REPORT_STORAGE_ENDPOINT_URL=
CLOUDSENTINEL_REPORT_STORAGE_ACCESS_KEY=
CLOUDSENTINEL_REPORT_STORAGE_SECRET_KEY=
CLOUDSENTINEL_REPORT_RETENTION_DAYS=90
# Must be at least as long as the longest primary or cross-region database backup retention.
CLOUDSENTINEL_OFFBOARDING_BACKUP_RETENTION_DAYS=35
CLOUDSENTINEL_LONGEST_BACKUP_RETENTION_DAYS=35
CLOUDSENTINEL_TASK_EXECUTION_MAX_ATTEMPTS=3
CLOUDSENTINEL_TASK_STALE_AFTER_MINUTES=30

# Optional OpenTelemetry export. In Kubernetes use the in-cluster collector URL.
CLOUDSENTINEL_OTEL_ENDPOINT=
CLOUDSENTINEL_OTEL_SAMPLE_RATIO=0.1

# Optional customer IaC/container assessment sandbox. Keep disabled until the
# matching private Fargate cluster, task definition, S3 bucket and IAM are ready.
CLOUDSENTINEL_CUSTOMER_SCAN_ENABLED=false
CLOUDSENTINEL_CUSTOMER_SCAN_BUCKET=
CLOUDSENTINEL_CUSTOMER_SCAN_PREFIX=cloudsentinel/customer-scans
CLOUDSENTINEL_CUSTOMER_SCAN_ECS_CLUSTER_ARN=
CLOUDSENTINEL_CUSTOMER_SCAN_TASK_DEFINITION_ARN=
CLOUDSENTINEL_CUSTOMER_SCAN_TASK_SUBNETS=
CLOUDSENTINEL_CUSTOMER_SCAN_TASK_SECURITY_GROUP=
CLOUDSENTINEL_CUSTOMER_SCAN_MAX_UPLOAD_BYTES=104857600
CLOUDSENTINEL_CUSTOMER_SCAN_TIMEOUT_SECONDS=900
